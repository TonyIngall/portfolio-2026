---
import Layout from '../layouts/Layout.astro';
import List from '../components/insights/list.astro';
---

<Layout title="Insights" description="Thoughts and insights on Motion, Accessibility, and Web Development.">
    <main id="insights">
        <h1>Insights</h1>
        <List />
    </main>
</Layout>

<style>
    #insights {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 15px;
        padding: 50px 33px;
        h1 {
            grid-column: 2 / span 5;
            font-size: 11.5vw;
            font-family: 'PP-Editorial-New-Ultrabold';
            text-align: center;
            text-transform: uppercase;
            color: var(--color-dark);
        }
        ul {
            grid-column: 2 / span 5;
        }
    }
    @media screen and (max-width: 1024px) {
        #insights {
            grid-template-columns: repeat(5, 1fr);
            padding: 50px 15px;
            h1 {
                font-size: 11.5vw;
                grid-column: 1 / span 5;
            }
            ul {
                grid-column: 1 / span 5;
            }
        }
    }
    @media screen and (max-width: 768px) {
        #insights {
            grid-template-columns: repeat(1, 1fr);
            padding: 25px 15px;
            h1 {
                font-size: 15vw;
                grid-column: 1 / span 1;
            }
            ul {
                grid-column: 1 / span 1;
            }
        }
    }
</style>