---
import Layout from '../layouts/Layout.astro';
import List from '../components/insights/list.astro';
---

<Layout title="Insights" description="Thoughts and insights on Motion, Accessibility, and Web Development.">
    <main id="insights">
        <h1>Insights</h1>
        <List />
    </main>
</Layout>

<style>
    #insights {
        padding: 50px 33px;
        h1 {
            font-size: 11.5vw;
            font-family: 'PP-Editorial-New-Ultrabold';
            text-transform: uppercase;
            color: transparent;
            -webkit-text-stroke: 2px var(--color-dark);
        }
    }
    @media screen and (max-width: 1024px) {
        #insights {
            padding: 50px 15px;
            h1 {
                font-size: 11.5vw;
            }
        }
    }
    @media screen and (max-width: 768px) {
        #insights {
            padding: 25px 15px;
            h1 {
                font-size: 15vw;
                -webkit-text-stroke: 1.5px var(--color-dark);
            }
        }
    }
</style>