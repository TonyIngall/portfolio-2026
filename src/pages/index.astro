---
import Layout from '../layouts/Layout.astro';
import Insights from '../components/home/insights.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <main id="home">
        <div id="title">
            <h1>Creative Developer</h1>
        </div>
        <div id="info">
            <p>Developer since 2020.</p>
            <p>Focusing on Motion & Accessibility.</p>
            <p>Based in Cambridgeshire.</p>
        </div>
        <div id="insights">
            <h2>Insights</h2>
            <Insights />
        </div>
    </main>
</Layout>

<style>
    /* ═════ Desktop ═════ */
    #home {
        display: grid;
        grid-template-columns: repeat(9, 1fr);
        grid-template-rows: 1fr auto 4fr;
        gap: 15px;
        padding: 0 33px;
        height: 100vh;
        overflow: hidden;

        #title {
            grid-column: 1 / span 9;
            grid-row: 3 / span 1;
            align-self: end;
            order: 99;
            h1 {
                display: flex;
                flex-flow: row wrap;
                font-size: 11.5vw;
                line-height: 0.85;
                font-family: 'PP-Editorial-New-Ultrabold';
                text-transform: uppercase;
                color: var(--color-dark);
                margin: 1.25rem 0 0 0;
            }
        }

        #info {
            order: 1;
            grid-column: 1 / span 5;
            grid-row: 2 / span 1;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            p {
                font-size: 1.5rem;
                &:nth-child(1) {
                    grid-column: 1 / span 2;
                }
                &:nth-child(2) {
                    grid-column: 3 / span 2;
                }
                &:nth-child(3) {
                    grid-column: 1 / span 2;
                    grid-row: 2 / span 1;
                }
            }
        }

        #info {
            order: 1;
            grid-column: 1 / span 5;
            grid-row: 2 / span 1;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            p {
                font-size: 1.5rem;
                &:nth-child(1) {
                    grid-column: 1 / span 2;
                }
                &:nth-child(2) {
                    grid-column: 3 / span 2;
                }
                &:nth-child(3) {
                    grid-column: 1 / span 2;
                    grid-row: 2 / span 1;
                }
            }
        }

        #insights {
            order: 2;
            grid-column: 6 / span 4;
            grid-row: 2 / span 1;
            h2 {
                font-family: 'PP-Editorial-New-Ultrabold';
                text-transform: uppercase;
                font-size: 1.5rem;
                line-height: 1;
            }
        }
    }

    /* ═════ Tablet ═════ */
    @media screen and (max-width: 1024px) {
        #home {
            grid-template-columns: repeat(5, 1fr);
            grid-template-rows: auto;
            padding: 0 15px;

            #title {
                grid-column: 1 / span 5;
                grid-row: 3 / span 1;
                h1 {
                    font-size: min(13.5vw, 8.5rem);
                }
            }

            #info {
                grid-column: 1 / span 5;
                grid-row: 2 / span 1;
                grid-template-columns: repeat(5, 1fr);
                p:nth-child(2) {
                    grid-column: 4 / span 2;
                }
            }

            #insights {
                grid-column: 1 / span 5;
                grid-row: 3 / span 1;
            }
        }
    }
    /* ═════ Mobile ═════ */
    @media screen and (max-width: 768px) {
        #home {
            grid-template-columns: 1fr;

            #title {
                grid-column: 3 / span 1;
                h1 {
                    font-size: min(11.5vw, 5.5rem);
                }
            }
        }
    }
</style>