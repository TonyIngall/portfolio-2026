---
import Layout from '../../layouts/Layout.astro';
import RichText from '../../components/content/RichText.astro';
import type { Article, ArticlesResponse, Category } from '../../types/articles';

import { gsap } from 'gsap';
import { Flip } from 'gsap/Flip';

// Fetch Article
const api = import.meta.env.PUBLIC_STRAPI_URL

export function getStaticPaths() {
    const api = import.meta.env.PUBLIC_STRAPI_URL
    const response = fetch(api + 'articles').then((response) => response.json()) as Promise<ArticlesResponse>;

    return response.then((data) => {
        const articles = data.data;
        return articles.map((article: Article) => ({
            params: { slug: article.slug },
        }));
    });
}

const response = await fetch(api + `articles?filters[slug]=${Astro.params.slug}&populate[blocks][populate]=*&populate[categories][populate][0]=colour&populate[series][populate][0]=colour`).then((response) => response.json()) as ArticlesResponse;
const article = response.data[0];

const { slug } = Astro.params;
---
<Layout title={article.title} description={article.description}>
    <article id="insight">
        <div id="loader-title">
            <h1>{article.title}</h1>
        </div>
        <div id="meta">
            <div id="title">
            </div>
            <div id="categories">
                {article.categories.map((category: Category) => (
                    <span class="category" style={`--cat-color: ${category.colour.hex};`}>{category.name}</span>
                ))}
            </div>
            <div id="series">
                {article.series && (
                    <span class="series" style={`--series-color: ${article.series.colour.hex};`}>{article.series.title}</span>
                )}
            </div>
        </div>
        <div class="content">
            {article.blocks.map((block) => {
                if (block.__component === 'shared.rich-text') {
                    return <RichText content={block.body} class="article-text" />;
                }
                return null;
            })}
        </div>
    </article>
</Layout>

<style>
    #insight {
        padding: 50px 33px;
        h1 {
            color: var(--color-dark);
            font-family: 'PP-Editorial-New-Ultrabold';
            line-height: 1;
            will-change: font-size, line-height, transform;
        }
        #loader-title {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            padding: 50px 33px;
            display: flex;
            align-items: center;
            justify-content: center;
            h1 {
                text-wrap: balance;
                font-size: 11.5vw;
                line-height: 1.15;
                opacity: 0;
            }
            .word {
                position: relative;
                display: inline-block;
                opacity: 1;
                width: fit-content;
                .wrap {
                    opacity: 0;
                }
                .overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    transform-origin: bottom center;
                    transform: scale(1, 0);
                    background: var(--color-primary);
                }
            }
        }
        #meta {
            #title {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                h1 {
                    text-wrap: balance;
                    font-size: 4.5rem;
                    color: var(--color-dark);
                    line-height: 1.15;
                }
            }
            #categories {
                opacity: 0;
            }
            #series {
                opacity: 0;
            }
        }
        .content {
            opacity: 0;
            max-width: 800px;
            margin: 0 auto;
            color: var(--color-dark);
            .article-text {
                p {
                    font-size: 18px;
                }
            }
        }
    }

    @media screen and (max-width: 1024px) {
        #insight {
            padding: 50px 15px;
            #loader-title {
                h1 {
                    font-size: 5rem;
                }
            }
            #meta {
                #title h1 {
                    font-size: 4rem;
                }
            }
        }
    }
</style>
<script>
    import { gsap } from 'gsap';
    import { Flip } from 'gsap/Flip';
    import { SplitText } from 'gsap/SplitText';
    
    gsap.registerPlugin(Flip, SplitText);
    
    const loaderTitle = document.getElementById('loader-title');
    const title = document.querySelector('#meta #title');
    const h1 = document.querySelector('#loader-title h1');

    const BlockTitle = () => {
        if(!loaderTitle || !h1) return;
        const split = new SplitText(h1, {
            type: 'words',
            wordsClass: 'word',
            onSplit: (self) => {
                gsap.set(h1, { opacity: 1 });
                self.words.forEach((word) => {
                    const content = word.innerHTML;
                    word.innerHTML = "";

                    const wrap = document.createElement("div");
                    wrap.classList.add("wrap");
                    wrap.innerHTML = content;

                    const overlay = document.createElement("div");
                    overlay.classList.add("overlay");

                    word.append(wrap, overlay);
                });

                const tl = gsap.timeline();

                self.words.forEach((word, i) => {
                const wrap = word.querySelector(".wrap");
                const overlay = word.querySelector(".overlay");

                const wordTl = gsap.timeline({});

                wordTl
                    .to(word, {
                        opacity: 1,
                        duration: 0.1
                    })
                    .to(overlay, {
                        scaleY: 1,
                        ease: "power1.in",
                        duration: 0.33
                    })
                    .set(wrap, { opacity: 1 })
                    .to(
                        overlay,
                        {
                            height: "0%",
                            ease: "power3.out",
                            duration: 0.33
                        },
                        "<=+0.06"
                    );

                    tl.add(wordTl, "<=" + 0.25);
                });
            }
        });
    }

    const FlipTitle = () => {
        if(!loaderTitle || !title || !h1) return;
        const state = Flip.getState(h1, { props: 'font-size,transform' });
        title.appendChild(h1);

        Flip.from(state, {
            duration: 1,
            delay: 0.15,
            ease: 'power3.out',
            absoluteOnLeave: true,
            onComplete: () => {
                gsap.to(['.content', '#categories', '#series'], { opacity: 1, duration: 0.33 });
                loaderTitle.style.display = 'none';
            }
        });
    }
    window.addEventListener('load', () => {
        BlockTitle();
        setTimeout(() => {
            FlipTitle();
        }, 2000);
    });
</script>