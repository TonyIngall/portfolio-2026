---
import Layout from '../../layouts/Layout.astro';
import RichText from '../../components/content/RichText.astro';
import CopyLink from '../../components/insights/copy-link.astro';
import NextInsight from '../../components/insights/next-insight.astro';
import RelatedInsights from '../../components/insights/related-insights.astro';
import type { Article, ArticlesResponse, Category } from '../../types/articles';

import { gsap } from 'gsap';
import { Flip } from 'gsap/Flip';

// Fetch Article
const api = import.meta.env.PUBLIC_STRAPI_URL

export function getStaticPaths() {
    const api = import.meta.env.PUBLIC_STRAPI_URL
    const response = fetch(api + 'articles').then((response) => response.json()) as Promise<ArticlesResponse>;

    return response.then((data) => {
        const articles = data.data;
        return articles.map((article: Article) => ({
            params: { slug: article.slug },
        }));
    });
}

const response = await fetch(api + `articles?filters[slug]=${Astro.params.slug}&populate[blocks][populate]=*&populate[categories][populate][0]=colour&populate[series][populate][0]=colour`).then((response) => response.json()) as ArticlesResponse;
const article = response.data[0];

const { slug } = Astro.params;
const site_url = import.meta.env.PUBLIC_SITE_URL
const url = `${site_url}/insights/${slug}`;
---
<Layout title={article.title} description={article.description}>
    <article id="insight">
        <div id="loader-title">
            <h1>{article.title}</h1>
        </div>
        <section id="top">
            <div id="title">
            </div>
            <div class="meta">
                <div id="series">
                    <p>Series:</p>
                    {article.series && (
                        <span class="series" style={`--series-color: ${article.series.colour.hex};`}>{article.series.title}</span>
                    )}
                </div>
                <div id="categories">
                    {article.categories && article.categories.length > 0 && (
                        <>
                            <p>Topics Covered:</p>
                            <div class="categories">
                                {article.categories.map((category: Category) => (
                                    <span class="category" style={`--cat-color: ${category.colour.hex};`}>{category.name}</span>
                                ))}
                            </div>
                        </>
                    )}
                </div>
            </div>
            <div id="date">
                {new Date(article.publishedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                })}
            </div>
        </section>
        <div class="content">
            {article.blocks.map((block) => {
                if (block.__component === 'shared.rich-text') {
                    return <RichText content={block.body} class="article-text" />;
                }
                return null;
            })}
        </div>
    </article>
    <div id="end">
        <section id="share">
            <div class="top">
                <h2>Did you enjoy this insight?</h2>
                <p>It always helps to share valuable content. If you found this to be helpful, interesting or anything in-between - then please share this insight page with the helpful buttons below.</p>
            </div>
            <div class="links">
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${url}`} target="_blank" rel="noopener noreferrer">Share on LinkedIn</a>
                <a href={`https://twitter.com/intent/tweet?url=${url}&text=${article.title}`} target="_blank" rel="noopener noreferrer">Share on Twitter</a>
                <a href={`https://www.facebook.com/sharer/sharer.php?u=${url}`} target="_blank" rel="noopener noreferrer">Share on Facebook</a>
                <a href={`https://www.reddit.com/submit?url=${url}&title=${article.title}`} target="_blank" rel="noopener noreferrer">Share on Reddit</a>
            </div>
            <div class="bottom">
                <p>Or just copy a link!</p>
                <CopyLink link={url} />
            </div>
        </section>
        <NextInsight slug={slug} />
        <RelatedInsights slug={slug} />
    </div>
</Layout>

<style>
    #insight {
        position: relative;
        padding: 50px 33px;
        h1 {
            text-wrap: balance;
            color: var(--color-dark);
            font-family: 'PP-Editorial-New-Ultrabold';
            line-height: 1;
            will-change: font-size, line-height, transform;
        }
        #loader-title {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            padding: 50px 33px;
            display: flex;
            align-items: center;
            justify-content: center;
            h1 {
                text-wrap: balance;
                font-size: 11.5vw;
                line-height: 1.15;
                opacity: 0;
            }
            .word {
                position: relative;
                display: inline-block;
                opacity: 1;
                width: fit-content;
                .wrap {
                    opacity: 0;
                }
                .overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    transform-origin: bottom center;
                    transform: scale(1, 0);
                    background: var(--color-primary);
                }
            }
        }
        #top {
            display: grid;
            grid-template-columns: 1fr 20%;
            margin-bottom: 50px;
            #title {
                order: 1;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                grid-column: 1 / span 2;
                h1 {
                    text-wrap: balance;
                    font-size: 4.5rem;
                    color: var(--color-dark);
                    line-height: 1.15;
                }
            }
            .meta {
                order: 3;
                opacity: 0;
                display: flex;
                flex-flow: column nowrap;
                gap: 15px;
                color: var(--color-dark);
                font-size: 18px;
                #series, #categories {
                    p {
                        margin-bottom: 5px;
                    }
                }
                #series .series {
                    display: inline-block;
                    padding: 0.33rem 1.12rem;
                    border-radius: 33px;
                    border: 1px solid var(--series-color);
                }
                #categories .categories {
                    display: flex;
                    flex-flow: row wrap;
                    gap: 10px;
                    .category {
                        display: inline-block;
                        border: 1px solid var(--cat-color);
                        padding: 0.33rem 1.12rem;
                        border-radius: 33px;
                    }
                }
            }
            #date {
                order: 2;
                opacity: 0;
                color: var(--color-dark);
                font-size: 18px;
            }
        }
        .content {
            opacity: 0;
            max-width: 800px;
            margin: 0 auto;
            color: var(--color-dark);
            .article-text {
                p {
                    font-size: 18px;
                }
            }
        }
    }

    #end {
        opacity: 0;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        column-gap: 66px;
        row-gap: 33px;
        padding: 100px 33px;
        box-shadow: inset 0px 33px 66px 0px var(--color-light);
        background-image: 
            linear-gradient(to right, #312b3614 1px, transparent 1px),
            linear-gradient(to bottom, #312b3614 1px, transparent 1px);
        background-size: 33px 33px;
        background-position: center;
        h2 {
            font-family: 'PP-Editorial-New-Ultrabold';
            font-size: 2.5rem;
            color: var(--color-dark);
        }
        p {
            font-size: 18px;
            color: var(--color-dark);
        }
        section {
            position: relative;
            border: 1px solid var(--color-dark);
            background-color: var(--color-light);
            padding: 50px 33px 30px 33px;
            border-radius: 33px;
            &#share {
                display: flex;
                justify-content: space-between;
                flex-flow: column nowrap;
                gap: 15px;
                grid-column: 2 / span 3;
                grid-row: 1 / span 2;
                .top {
                    display: flex;
                    flex-flow: column nowrap;
                    gap: 15px;
                }
                .links {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 15px;
                }
                .bottom {
                    margin-top: 50px;
                    display: flex;
                    flex-flow: column nowrap;
                    gap: 15px;
                    .copy-link {
                        position: absolute;
                        bottom: -25px;
                        right: 33px;
                    }
                }
            }
            &#next, &#previous, &#related {
                grid-row: span 1;
                grid-column: 5 / span 3;
            }
        }
    }

    @media screen and (max-width: 1024px) {
        #insight {
            padding: 50px 15px;
            #loader-title {
                h1 {
                    font-size: 5rem;
                }
            }
            #top {
                grid-template-columns: 1fr;
                row-gap: 33px;
                #title {
                    grid-column: 1 / span 1;
                    h1 {
                        font-size: 4rem;
                    }
                }
            }
        }
        #end {
            grid-template-columns: 1fr;
            row-gap: 33px;
            padding: 50px 15px;
            section {
                &#share {
                    grid-column: 1 / span 1;
                    grid-row: 1 / span 1;
                }
                &#next, &#previous, &#related {
                    grid-column: 1 / span 1;
                    grid-row: span 1;
                }
            }
        }
    }
</style>
<script>
    import { animateIn } from '../../animations/insight-single';

    window.addEventListener('load', async () => {
        await animateIn();
    });
</script>