---
const { title, description } = Astro.props;
import Header from '../components/ui/header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title} | Tony Ingall</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Header />
		<main id="swup">
			<slot />
		</main>
	</body>
</html>

<style>
	:root {
		--color-primary: #e76598;
		--color-dark: #312b36;
		--color-light: #fdfcfc;
		--color-accent: #efe5e7;
	}
	/* ═════ Fonts ═════ */
	@font-face {
		font-family: 'PP-Editorial-New-Ultrabold';
		src: url('../assets/fonts/PPEditorialNew-Ultrabold.woff') format('woff');
		font-style: normal;
		font-weight: 400;
	}
	@font-face {
		font-family: 'PP-Object-Sans-Regular';
		src: url('../assets/fonts/PPObjectSans-Regular.woff') format('woff');
		font-style: normal;
		font-weight: 400;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		font-family: 'PP-Object-Sans-Regular', sans-serif;
		background-color: var(--color-light);
		h1,h2,h3,h4,h5,h6,p,span,a,li {
			letter-spacing: -0.33px;
			margin: 0px;
			margin-block-start: 0px;
			margin-block-end: 0px;
		}
	}

</style>
<script data-swup-ignore-script>
	import Lenis from 'lenis';
	import 'lenis/dist/lenis.css';
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import Swup from 'swup';
	import SwupJsPlugin from '@swup/js-plugin';
	import SwupHeadPlugin from '@swup/head-plugin';
	import SwupScriptsPlugin from '@swup/scripts-plugin';
	import { animateIn } from '../animations/insight-single';

	let lenis = null;

	const initLenis = () => {
		if (lenis) return lenis;

		lenis = new Lenis({
			smoothWheel: true,
			syncTouch: true,
			touchMultiplier: 1,
			easing: (t) => Math.min(1, 1.001 - Math.pow(1 - t, 4)),
		});

		lenis.on('scroll', () => {
			ScrollTrigger.update();
		});

		gsap.ticker.add((time) => {
			lenis?.raf(time * 1000);
		});
	}

	initLenis();
	
	// Swup Animations
	const anims = [
		{
			from: '(.*)',
			to: '/insights/:slug',
			out: async () => {
				await gsap.to('#swup', { opacity: 0, duration: 0.33 });
			},
			in: async () => {
				lenis?.scrollTo(0, { immediate: true });
				await animateIn();
			}
		},
		{
			from: '(.*)',
			to: '(.*)',
			out: async () => {
				await gsap.to('#swup', { opacity: 0, duration: 0.33 });
			},
			in: async () => {
				lenis?.scrollTo(0, { immediate: true });
				await gsap.fromTo('#swup', { opacity: 0 }, { opacity: 1, duration: 0.33 });
			}
		}
	]

	// Swup Init
	const swup = new Swup({
		containers: ['#swup'],
		plugins: [
			new SwupJsPlugin({
				animations: anims,
			}),
			new SwupHeadPlugin(),
			new SwupScriptsPlugin()
		]
	});
</script>