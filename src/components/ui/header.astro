---
import Icon from "./Icon.astro"
---

<header>
    <div id="pill">
        <div id="pill-inner">
            <p>TI</p>
            <div id="menu-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="4" x2="24" y2="4" stroke-width="2" stroke="#312B36"/>
                    <line x1="0" y1="11" x2="24" y2="11" stroke-width="2" stroke="#312B36"/>
                    <line x1="0" y1="18" x2="24" y2="18" stroke-width="2" stroke="#312B36"/>
                </svg>
            </div>
        </div>
    </div>
    <nav>
        <div class="nav-inner">
            <div id="pages">
                <p>Pages</p>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/insights">Insights</a></li>
                </ul>
            </div>
            <div id="contact">
                <p>Say <a href="mailto:hello@tonyingall.com">Hello<span>@tonyingall.com</span></a></p>
            </div>
            <div id="socials">
                <p>See also:</p>
                <ul>
                    <li><a href="https://www.linkedin.com/in/tony-ingall/">
                        <span>LinkedIn</span>
                        <Icon name="linkedin" />
                    </a></li>
                    <li><a href="https://www.github.com/tonyingall">
                        <span>GitHub</span>
                        <Icon name="github" />
                    </a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div id="nav-bg"></div>
</header>
<style>
    header {
        position: fixed;
        top: 15px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        #pill {
            margin: 0 auto;
            width: 15vw;
            max-width: 66vw;
            #pill-inner {
                display: flex;
                flex-flow: row nowrap;
                align-items: center;
                justify-content: space-between;
                gap: 33px;
                padding: 15px 33px;
            }
            #menu-icon {
                position: relative;
                cursor: pointer;
                height: 24px;
                svg {
                    position: relative;
                    line {
                        transform-origin: center;
                        will-change: transform, opacity;
                    }
                }
            }
        }
        nav {
            height: 0px;
            width: 0px;
            max-width: 66vw;
            overflow: hidden;
            .nav-inner {
                display: grid;
                grid-template-areas:
                    "pages pages"
                    "contact socials";
                row-gap: 66px;
                padding: 33px 33px 15px 33px;
            }
            #pages {
                grid-area: pages;
                p {
                    margin-bottom: 15px;
                }
                ul {
                    display: flex;
                    flex-flow: row nowrap;
                    gap: 15px;
                    width: fit-content;
                    padding: 0px;
                    margin: 0px;
                    li {
                        list-style: none;
                        > a {
                            color: var(--color-dark);
                            font-size: 1.5rem;
                            text-decoration: none;
                            &:visited {
                                color: unset;
                            }
                        }
                    }
                }
            }
            #contact {
                grid-area: contact;
                font-family: 'PP-Editorial-New-Ultrabold', sans-serif;
                text-transform: uppercase;
                font-size: 3rem;
                color: var(--color-dark);
                a {
                    display: inline-flex;
                    flex-flow: column nowrap;
                    color: var(--color-primary);
                    text-decoration: none;
                    span {
                        margin-top: -15px;
                        display: block;
                        font-size: 1.5rem;
                    }
                }
            }
            #socials {
                grid-area: socials;
                display: flex;
                flex-flow: row nowrap;
                justify-content: flex-end;
                gap: 33px;
                ul {
                    display: flex;
                    flex-flow: row nowrap;
                    gap: 15px;
                    width: fit-content;
                    padding: 0px;
                    margin: 0px;
                    li {
                        list-style: none;
                        > a {
                            color: var(--color-dark);
                            font-size: 1.5rem;
                            text-decoration: none;
                            span {
                                position: absolute;
                                width: 1px;
                                height: 1px;
                                padding: 0;
                                margin: -1px;
                                overflow: hidden;
                                clip: rect(0, 0, 0, 0);
                                white-space: nowrap;
                                border: 0;
                            }
                            svg {
                                width: 66px;
                            }
                            &:visited {
                                color: unset;
                            }
                        }
                    }
                }
            }
        }
        #nav-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--color-light);
            border-radius: 33px;
            box-shadow: 0px 6px 6px 6px rgba(239, 229, 231, 0.66);
            z-index: -1;
        }
    }
    
    @media screen and (max-width: 768px) {
        header {
            #pill {
                width: 33vw;
                max-width: calc(100vw - 30px);
            }
            nav {
                max-width: calc(100vw - 30px);
                .nav-inner {
                    grid-template-rows: 1fr auto auto;
                    grid-template-areas:
                        "pages"
                        "contact"
                        "socials";
                    row-gap: 15px;
                    height: calc(100vh - 150px);
                    padding: 33px 15px;
                }
                #pages {
                    height: 100%;
                    p {
                        display: none;
                    }
                    ul {
                        flex-flow: column nowrap;
                        gap: 15px;
                    }
                }
                #contact {
                    font-size: 2.5rem;
                    a > span {
                        margin-top: -10px;
                        font-size: 1.25rem;
                    }
                }
                #socials {
                    align-items: flex-end;
                    flex-flow: column nowrap;
                    p {
                        display: none;
                    }
                    ul {
                        gap: 15px;
                    }
                }
            }
        }
    }
</style>
<script>
    import { gsap } from 'gsap';
    const pill = document.querySelector('header > div');
    const menuIcon = document.getElementById('menu-icon');
    const nav = document.querySelector('nav');
    const navInner = document.querySelector('nav .nav-inner');
    let menuOpen: boolean = false,
        tl: gsap.core.Timeline | null = null;

    const init = () => {
        if(!pill || !menuIcon || !nav) return;
        if(tl) tl.kill();
        const innerHeight = navInner ? navInner.scrollHeight : 0;
        tl = gsap.timeline({ paused: true });
        const lines = gsap.utils.toArray('#menu-icon line') as SVGRectElement[];

        // Pill Expansion
        tl.to(pill, {
            duration: 0.66,
            ease: 'power1.inOut',
            easeReverse: 'back.inOut(0.66)',
            width: '100vw',
        }, 0)

        // Icon Transformation
        tl.to(lines, {
            duration: 0.66,
            ease: 'power4.out',
            rotate: -66,
            y: (i) => i === 0 ? 7 : i === 1 ? 0 : -7,
            transformOrigin: 'center',
        }, 0)
        tl.to([lines[1], lines[2]], {
            duration: 0.66,
            ease: 'power4.out',
            opacity: 0,
        }, 0)

        // Nav Reveal
        tl.set(nav, { width: '100vw' }, 0.33)
        tl.to(nav, {
            duration: 0.66,
            ease: 'power4.out',
            height: `${innerHeight}px`,
            pointerEvents: 'all',
        }, 0.33)
    }
    init();

    window.addEventListener('resize', () => {
        init();
        if (!menuOpen) return;
        const innerHeight = navInner ? navInner.scrollHeight : 0;
        tl?.set(nav, { height: `${innerHeight}px` });
    });

    const toggleMenu = () => {
        if (!tl) return;
        menuOpen ? tl.reverse() : tl.play();
        menuOpen = !menuOpen;
    }

    menuIcon ? menuIcon.addEventListener('click', toggleMenu) : null;
</script>