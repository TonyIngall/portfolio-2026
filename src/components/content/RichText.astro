---
import { marked } from 'marked';

const { content } = Astro.props;
const htmlContent = marked.parse(content);
---

<div class="text-content" set:html={htmlContent}>
</div>

<style>
    .text-content {
        font-family: 'PP-Object-Sans-Regular';
        > *:not(:last-child) {
            margin-bottom: 1.25rem;
        }
    }
</style>