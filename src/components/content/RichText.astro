---
import { marked } from 'marked';

const { content, class: className, ...rest } = Astro.props;
const htmlContent = marked.parse(content);
---

<div class:list={['text-content', className]} set:html={htmlContent} {...rest}>
</div>

<style>
    .text-content {
        font-family: 'PP-Object-Sans-Regular';
        > *:not(:last-child) {
            margin-bottom: 1.25rem;
        }
    }
</style>