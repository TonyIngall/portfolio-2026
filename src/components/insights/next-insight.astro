---
import type { Article, ArticlesResponse, Category } from '../../types/articles';
const { slug } = Astro.props;

const api = import.meta.env.PUBLIC_STRAPI_URL;

const curResponse = await fetch(api + `articles?filters[slug][$eq]=${slug}`).then((response) => response.json()) as ArticlesResponse;
const curArticle = curResponse.data[0] as Article;

const nextResponse = await fetch(api + `articles?filters[publishedAt][$gt]=${curArticle.publishedAt}&sort=publishedAt:asc&pagination[limit]=1&populate[categories][populate][0]=colour&populate[series][populate][0]=colour`).then((response) => response.json()) as ArticlesResponse;
const article = nextResponse.data[0] as Article;

---
<section id="next">
    <h2>Next insight</h2> 
    {article ? (
        <a href={`/insights/${article.slug}`}>
            <span class="title">{article.title}</span>
            <div class="categories">
                {article.categories && article.categories.map((category: Category) => (
                    <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                ))}
            </div>
            {article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
        </a>
    ) : (
        <p>Coming soon...</p>
    )}
</section>

<style>
    #next {
        h2 {
            margin-bottom: 0.5rem;
        }
        a {
            width: 100%;
            display: grid;
            grid-template-columns: auto auto;
            grid-template-rows: auto auto;
            align-items: center;
            gap: 6px 15px;
            text-decoration: none;
            color: var(--color-dark);
            .categories {
                display: flex;
                flex-flow: row nowrap;
                gap: 10px;
                .category {
                    border: 1px solid var(--cat-color);
                    padding: 0.33rem 1.12rem;
                    border-radius: 33px;
                }
            }
            .series {
                grid-column: 1 / span 2;
                width: fit-content;
                border: 1px solid var(--series-color);
                padding: 0.33rem 1.12rem;
                border-radius: 33px;
            }
        }
    }
    @media (max-width: 768px) {
        #next {
            a {
                grid-template-columns: 1fr;
                align-items: flex-start;
                gap: 9px;
                .categories {
                    flex-flow: row wrap;
                }
                .series {
                    grid-column: 1 / span 1;
                }
            }
        }
    }
</style>