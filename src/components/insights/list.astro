---
import type { Article, ArticlesResponse, Category } from '../../types/articles';

const api = import.meta.env.PUBLIC_STRAPI_URL
const response = await fetch(api + 'articles?sort[0]=publishedAt:desc&populate[categories][populate][0]=colour&populate[series][populate][0]=colour').then((response) => response.json()) as ArticlesResponse;
const articles = response.data;
---

<ul>
    {articles.map((article: Article) => (
        <li>
            <a href={'/insights/' + article.slug}>
                <span class="title">{article.title}</span>
                <div class="category">
                    {article.categories && article.categories.map((category: Category) => (
                        <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                    ))}
                </div>
                {article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
            </a>
        </li>
    ))}
</ul>