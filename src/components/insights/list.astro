---
import type { Article, ArticlesResponse, Category } from '../../types/articles';
const { hasTitle = true, hasCategories = true, hasSeries = true, hasDate = false } = Astro.props;

const api = import.meta.env.PUBLIC_STRAPI_URL
const response = await fetch(api + 'articles?sort[0]=publishedAt:desc&populate[categories][populate][0]=colour&populate[series][populate][0]=colour').then((response) => response.json()) as ArticlesResponse;
const articles = response.data;
---

<ul>
    {articles.map((article: Article) => (
        <li>
            <a href={'/insights/' + article.slug}>
                {hasTitle && <span class="title">{article.title}</span>}
                {hasDate && <span class="date">{new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
                {hasCategories && (
                    <div class="categories">
                        {article.categories && article.categories.map((category: Category) => (
                            <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                        ))}
                    </div>
                )}
                {hasSeries && article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
            </a>
        </li>
    ))}
</ul>

<style>
    ul {
        padding-left: 0px;
        li {
            list-style: none;
            a {
                width: 100%;
                display: flex;
                flex-flow: row nowrap;
                align-items: center;
                gap: 15px;
                text-decoration: none;
                color: var(--color-dark);
                .categories {
                    display: flex;
                    flex-flow: row wrap;
                    gap: 15px;
                    .category {
                        border: 1px solid var(--cat-color);
                        padding: 0.33rem 1.12rem;
                        border-radius: 33px;
                    }
                }
                .series {
                    border: 1px solid var(--series-color);
                    padding: 0.33rem 1.12rem;
                    border-radius: 33px;
                }
            }
        }
    }
</style>