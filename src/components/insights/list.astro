---
import type { Article, ArticlesResponse, Category } from '../../types/articles';
const {
    hasTitle = true,
    hasCategories = true,
    hasSeries = true,
    hasDate = false,
    limit = 999
} = Astro.props;

const api = import.meta.env.PUBLIC_STRAPI_URL
const response = await fetch(api + `articles?sort[0]=publishedAt:desc&populate[categories][populate][0]=colour&populate[series][populate][0]=colour${limit !== null ? '&pagination[limit]=' + limit : ''}`).then((response) => response.json()) as ArticlesResponse;
const articles = response.data;
---

<ul>
    {articles.map((article: Article) => {
        const date = new Date(article.publishedAt);
        const isNew = (new Date().getTime() - date.getTime()) < 1000 * 60 * 60 * 24 * 7; // 7 days
        return (
            <li>
            <a href={'/insights/' + article.slug}>
                {hasTitle && <span class="title">{article.title}</span>}
                {hasDate && <span class="date">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
                {hasCategories && (
                    <div class="categories">
                        {article.categories && article.categories.map((category: Category) => (
                            <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                        ))}
                    </div>
                )}
                {hasSeries && article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
                {isNew && <div class="new"><span>New</span></div>}
            </a>
        </li>
        )
    })}
</ul>

<style>
    ul {
        padding-left: 0px;
        li {
            list-style: none;
            a {
                position: relative;
                width: 100%;
                display: flex;
                flex-flow: row nowrap;
                align-items: center;
                gap: 15px;
                text-decoration: none;
                color: var(--color-dark);
                .categories {
                    display: flex;
                    flex-flow: row wrap;
                    gap: 15px;
                    .category {
                        border: 1px solid var(--cat-color);
                        padding: 0.33rem 1.12rem;
                        border-radius: 33px;
                    }
                }
                .series {
                    border: 1px solid var(--series-color);
                    padding: 0.33rem 1.12rem;
                    border-radius: 33px;
                }
                .new {
                    position: absolute;
                    top: -33px;
                    left: -66px;
                    width: 66px;
                    height: 66px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background-color: var(--color-primary);
                    color: var(--color-light);
                    border-radius: 33px;
                    transform: rotate(-15deg) scale(0);
                    overflow: hidden;
                    span {
                        display: inline-block;
                        margin-top: 6px;
                        font-family: 'PP-Editorial-New-Ultrabold';
                        text-transform: uppercase;
                        font-size: 1.25rem;
                    }
                }
            }
        }
    }
    @media (max-width: 768px) {
        ul {
            li {
                a {
                    flex-flow: column nowrap;
                    align-items: flex-start;
                    .categories {
                        gap: 6px;
                    }
                    .new {
                        top: -33px;
                        left: unset;
                        right: 0px;
                    }
                }
            }
        }
    }
</style>
<script>
    import { gsap } from 'gsap';

    const n = document.querySelectorAll('.new');
    n.forEach((el) => {
        const tl = gsap.timeline({ repeat: 0, yoyo: false });
        const rotateTl = gsap.timeline({ repeat: -1, yoyo: false, repeatDelay: 0.66 });
        tl.to(el, {
            scale: 1,
            rotate: -15,
            duration: 0.33,
            delay: 0.66,
            ease: 'back.out(1.7)',
        });
        rotateTl.fromTo(el.querySelector('span'), {
            xPercent: -115,
        }, {
            xPercent: 115,
            duration: 1.23,
            ease: 'linear',
        });
    });
</script>