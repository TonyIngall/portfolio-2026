---
import type { Article, ArticlesResponse, Category } from '../../types/articles';
const { slug } = Astro.props;

const api = import.meta.env.PUBLIC_STRAPI_URL;

const curResponse = await fetch(api + `articles?filters[slug][$eq]=${slug}`).then((response) => response.json()) as ArticlesResponse;
const curArticle = curResponse.data[0] as Article;

const nextResponse = await fetch(api + `articles?filters[publishedAt][$lt]=${curArticle.publishedAt}&sort=publishedAt:asc&pagination[limit]=3&populate[categories][populate][0]=colour&populate[series][populate][0]=colour`).then((response) => response.json()) as ArticlesResponse;
const articles = nextResponse.data as Article[];

---
<section id="previous">
    <h2>Previous insights</h2> 
    {articles.length > 0 ? (
        <ul>
            {articles.map((article: Article) => (
                <li>
                    <a href={`/insights/${article.slug}`}>
                        <span class="title">{article.title}</span>
                        <div class="categories">
                            {article.categories && article.categories.map((category: Category) => (
                                <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                            ))}
                        </div>
                        {article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
                    </a>
                </li>
            ))}
        </ul>
    ) : (
        <p>Nothing yet...</p>
    )}
</section>

<style>
    #previous {
        h2 {
            margin-bottom: 0.5rem;
        }
        a {
            width: 100%;
            display: grid;
            grid-template-columns: auto auto;
            grid-template-rows: auto auto;
            align-items: center;
            gap: 6px 15px;
            text-decoration: none;
            color: var(--color-dark);
            .categories {
                display: flex;
                flex-flow: row nowrap;
                gap: 10px;
                .category {
                    border: 1px solid var(--cat-color);
                    padding: 0.33rem 1.12rem;
                    border-radius: 33px;
                }
            }
            .series {
                grid-column: 1 / span 2;
                width: fit-content;
                border: 1px solid var(--series-color);
                padding: 0.33rem 1.12rem;
                border-radius: 33px;
            }
        }
    }
    @media (max-width: 768px) {
        #previous {
            a {
                grid-template-columns: 1fr;
                align-items: flex-start;
                gap: 9px;
                .categories {
                    flex-flow: row wrap;
                }
                .series {
                    grid-column: 1 / span 1;
                }
            }
        }
    }
</style>