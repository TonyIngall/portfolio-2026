---
import RichText from '../content/RichText.astro';
import Icon from '../ui/Icon.astro';

const api = import.meta.env.PUBLIC_STRAPI_URL
const response = await fetch(api + 'about?populate[blocks][populate]=*').then((response) => response.json());
const about = response.data;
const aboutContent = about.blocks;
---
<div id="bio">
    {aboutContent.map((block: any) => {
        switch (block.__component) {
            case 'shared.rich-text':
                return <RichText content={block.body} class="description" />;
            case 'shared.media':
                return <img class="profile" src={block.file.url} alt={block.file.alternativeText} />;
            default:
                return null;
        }
    })}
    <div class="socials">
        <a href="https://github.com/tonyingall" target="_blank" rel="noopener noreferrer">
            <Icon name="github" size="md" class="social-icon" />
            <span class="sr-only">GitHub</span>
        </a>
        <a href="https://linkedin.com/in/anthonyingall" target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size="md" class="social-icon" />
            <span class="sr-only">LinkedIn</span>
        </a>
    </div>
</div>
<style>
    #bio {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        align-items: center;
        gap: 33px;
        .description {
            order: 2;
            grid-column: span 2;
        }
        .profile {
            order: 1;
            grid-column: 2 / span 2;
            grid-row: 1 / span 2;
            width: 100%;
            height: auto;
            border-radius: 15px;
        }
        .socials {
            order: 3;
            grid-column: 4 / span 2;
            display: flex;
            gap: 15px;
            align-items: center;
            justify-content: flex-start;
            svg {
                color: var(--color-dark);
                width: 66px;
                height: 66px;
            }
            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border-width: 0;
            }
            .social-icon {
                cursor: pointer;
                transition: transform 0.2s ease-in-out;
                &:hover {
                    transform: scale(1.1);
                }
            }
        }
    }
    @media screen and (max-width: 1024px) {
        #bio {
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            .description {
                order: 2;
                grid-column: span 3;
            }
            .profile {
                order: 1;
                grid-column: 1 / span 2;
            }
            .socials {
                order: 3;
                grid-column: 3 / span 2;
            }
        }
    }
    @media screen and (max-width: 768px) {
        #bio {
            grid-template-columns: repeat(1, 1fr);
            gap: 15px;
            .description {
                order: 2;
                grid-column: span 1;
            }
            .profile {
                order: 1;
                grid-column: 1 / span 1;
            }
            .socials {
                order: 3;
                grid-column: 1 / span 1;
                gap: 33px;
            }
        }
    }
</style>