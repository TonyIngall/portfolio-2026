---
import type { Article, ArticlesResponse, Category } from '../../types/articles';

const api = import.meta.env.PUBLIC_STRAPI_URL
const response = await fetch(api + 'articles?sort[0]=publishedAt:desc&populate[categories][populate][0]=colour&populate[series][populate][0]=colour&limit=3').then((response) => response.json()) as ArticlesResponse;
const articles = response.data;
---

<ul>
    {articles.map((article: Article) => (
        <li>
            <a href={'/insights/' + article.slug}>
                <span class="title">{article.title}</span>
                <div class="categories">
                    {article.categories && article.categories.map((category: Category) => (
                        <span class="category" style={`--cat-color: ${category.colour.hex}`}>{category.name}</span>
                    ))}
                </div>
                {article.series && <span class="series" style={`--series-color: ${article.series.colour.hex}`}>{article.series?.title}</span>}
            </a>
        </li>
    ))}
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        li {
            margin-bottom: 1rem;
            a {
                display: flex;
                align-items: center;
                flex-flow: row nowrap;
                gap: 15px;
                text-decoration: none;
                font-size: 1.25rem;
                color: var(--color-dark);
                .categories {
                    display: flex;
                    flex-flow: row wrap;
                    gap: 15px;    
                    .category {
                        padding: 0.33rem 1.12rem;
                        border: 1px solid var(--cat-color);
                        border-radius: 33px;
                    }
                }
                .series {
                    padding: 0.33rem 1.12rem;
                    border: 1px solid var(--series-color);
                    border-radius: 33px;
                }
            }
        }
    }
    @media screen and (max-width: 1024px) {
        li a {
            align-items: flex-start;
            flex-flow: column nowrap;
        }
    }
</style>